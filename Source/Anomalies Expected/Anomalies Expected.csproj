<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<DebugType>embedded</DebugType>
		<RootNamespace>AnomaliesExpected</RootNamespace>
		<AssemblyName>Anomalies Expected</AssemblyName>
		<LangVersion>latest</LangVersion>
		<Deterministic>true</Deterministic>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    
		<Configurations>1.5;1.6;1.7</Configurations>
    
		<AssemblyTitle>Anomalies Expected</AssemblyTitle>
		<Description/>
		<Company>Hydra Digital Development</Company>
		<Product>Anomalies Expected</Product>
		<Copyright>Copyright © 2026</Copyright>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == '1.5'">
		<OutputPath>..\..\1.5\Assemblies\</OutputPath>
		<DefineConstants>TRACE;v1_5</DefineConstants>
		<Optimize>true</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == '1.6'">
		<OutputPath>..\..\1.6\Assemblies\</OutputPath>
		<DefineConstants>TRACE;v1_6</DefineConstants>
		<Optimize>true</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == '1.7'">
		<OutputPath>..\..\1.7\Assemblies\</OutputPath>
		<DefineConstants>TRACE;v1_6</DefineConstants>
		<Optimize>true</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="UnityStubs">
			<HintPath>..\..\..\..\UnityStubs.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Waylith">
			<HintPath>..\..\..\..\Waylith.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4982-unstable"/>
		<PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" IncludeAssets="compile" PrivateAssets="all"/>
	</ItemGroup>

</Project>